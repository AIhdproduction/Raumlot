# Optional API key for the OpenRouter backend. Never commit a real key.
OPENROUTER_API_KEY=

# Location of local E57 smoke-test data.
RAUMLOT_TESTDATA=D:\Raumlot\test_PW

# Preferred SAM 3.1 multiplex checkpoint. Leave empty to use models/sam3.1_multiplex.pt.
RAUMLOT_SAM_CHECKPOINT=

# Fallback SAM 3 checkpoint. Leave empty to use D:\Nomivox\models\sam3.pt.
RAUMLOT_SAM3_FALLBACK_CHECKPOINT=

# Repository root for paths that default below it. Leave empty for the editable-install root.
RAUMLOT_HOME=
